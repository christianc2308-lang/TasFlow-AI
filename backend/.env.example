# Copia este archivo como .env y rellena los valores. El .env NUNCA se sube a GitHub.

# Google Cloud Console → APIs y servicios → Credenciales → ID de cliente OAuth (Aplicación web)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback

# URL pública de TaskFlow AI (para el enlace a la tarea dentro del evento)
APP_URL=http://localhost:3000
